# Port tempat Express listen. Jangan di-hardcode di produksi:
# Hostinger dan platform lain menetapkan PORT sendiri saat runtime.
PORT=3001

# Umur cache berita dalam menit.
# 0 = setiap request mengambil feed baru (cocok untuk pengembangan).
# 15 = produksi; mencegah tiap pengunjung memicu fetch ke publisher.
CACHE_TTL_MS=0

# Batas request per menit per IP untuk /api/news. 0 = matikan rate limit.
# WAJIB 0 di Vercel: tanpa trust proxy yang benar semua pengunjung terlihat
# dari satu IP sehingga seluruh situs bisa kena 429.
RATE_LIMIT_MAX=30

# Jumlah reverse proxy tepercaya di depan aplikasi. Set 1 di Vercel atau
# Hostinger di belakang proxy, biarkan 0 saat diakses langsung.
TRUST_PROXY_HOPS=0

# Origin frontend yang diizinkan, dipisah koma. Wildcard * hanya untuk
# label host, jadi https://my-app*.vercel.app tidak ikut menerima origin
# dari project Vercel lain.
FRONTEND_ORIGINS=http://localhost:5173,https://my-app*.vercel.app
